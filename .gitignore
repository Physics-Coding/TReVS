*.py[cod]
*$py.class
*.pyd
*.so
.pytest_cache/
.mypy_cache/
.pyre/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.ipynb_checkpoints/

# Build and packaging output
/build/
/dist/
*.egg-info/
*.egg
wheelhouse/
pip-wheel-metadata/

# Local Python/Conda environments
/.conda/
/.venv/
/venv/
/env/
/.direnv/
/.envrc
conda-meta/

# Editor and operating-system state
/.idea/
/.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

